{
  "manifest_version": 3,
  "name": "PitLingo — F1TV 繁體中文字幕",
  "short_name": "PitLingo",
  "version": "0.1.0",
  "description": "把 F1TV 的英文 CC 即時翻譯成繁體中文，雙語疊字顯示。保留 F1TV 原本的多視角與英文原聲體驗。",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://f1tv.formula1.com/*",
    "https://f1zh-api.pitlingo.workers.dev/*"
  ],

  "background": {
    "service_worker": "src/background/sw.js"
  },

  "content_scripts": [
    {
      "matches": ["https://f1tv.formula1.com/*"],
      "js": [
        "src/shared/normalize.js",
        "src/shared/defaults.js",
        "src/content/main.js"
      ],
      "css": ["src/content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "PitLingo",
    "default_popup": "src/options/options.html"
  }
}
